{"format":"macromaxx-plugin/1","manifest":{"schemaVersion":1,"id":"example--counter","publisher":"example","name":"Counter","description":"Count key presses with a configurable label. No network or system access.","version":"1.0.0","apiVersion":1,"appVersion":">=0.1.0 <1.0.0","runtime":"standard","platforms":["linux","win32","darwin"],"permissions":["display:write","settings:read","settings:write"],"actions":[{"id":"count","name":"Count presses","fields":[{"key":"label","label":"Counter label","default":"Count"}]}]},"code":"\"use strict\";\nvar __pluginModule = (() => {\n  var __defProp = Object.defineProperty;\n  var __getOwnPropDesc = Object.getOwnPropertyDescriptor;\n  var __getOwnPropNames = Object.getOwnPropertyNames;\n  var __hasOwnProp = Object.prototype.hasOwnProperty;\n  var __export = (target, all) => {\n    for (var name in all)\n      __defProp(target, name, { get: all[name], enumerable: true });\n  };\n  var __copyProps = (to, from, except, desc) => {\n    if (from && typeof from === \"object\" || typeof from === \"function\") {\n      for (let key of __getOwnPropNames(from))\n        if (!__hasOwnProp.call(to, key) && key !== except)\n          __defProp(to, key, { get: () => from[key], enumerable: !(desc = __getOwnPropDesc(from, key)) || desc.enumerable });\n    }\n    return to;\n  };\n  var __toCommonJS = (mod) => __copyProps(__defProp({}, \"__esModule\", { value: true }), mod);\n\n  // src/index.ts\n  var index_exports = {};\n  __export(index_exports, {\n    default: () => index_default\n  });\n\n  // node_modules/@macromaxx/plugin-sdk/src/index.js\n  function definePlugin(plugin) {\n    return plugin;\n  }\n\n  // src/index.ts\n  var index_default = definePlugin({\n    activate(api) {\n      api.log(\"Counter activated\");\n    },\n    deactivate(api) {\n      api.log(\"Counter deactivated\");\n    },\n    actions: {\n      count: {\n        keyDown(_event, api) {\n          api.display.set({ color: \"#ffffff\" });\n        },\n        async execu