# Copy outside Git to ~/.config/macromaxx-registry-monitor.env, mode 0600.
# Values are example PATHS; substitute the external monitor account's actual home.
MONITOR_STATE_DIRECTORY=/home/macromaxx-monitor/.local/share/macromaxx-registry-monitor
MONITOR_ROOT_FILE=/home/macromaxx-monitor/.config/macromaxx-production-root.json
# Independently reviewed public-root fingerprint, NOT sha256sum of the pretty file.
MONITOR_ROOT_SHA256=b5aeb97545789a359f275d828d7c3cf4e1b926460c8b931f52f6f96c26ee8460
# HTTPS endpoints receiving JSON POST. Fill locally; never commit real values.
# Alert receiver must route failures/warnings/recovery to an attended destination.
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_TOKEN=
# A separate dead-man service must alert if healthy heartbeats stop for 30 minutes.
MONITOR_HEARTBEAT_URL=
MONITOR_HEARTBEAT_TOKEN=
