# Example USER service on an always-on host outside GitHub Actions.
# Review paths before installation; /usr/bin/node must meet package.json engines.
[Unit]
Description=Verify MacroMaxx production registry and notify external receivers
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/macromaxx-plugin-registry
EnvironmentFile=%h/.config/macromaxx-registry-monitor.env
ExecStart=/usr/bin/node %h/macromaxx-plugin-registry/src/monitor-cli.js probe
UMask=0077
NoNewPrivileges=yes
TimeoutStartSec=4min
